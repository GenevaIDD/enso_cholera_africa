# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Graphify outputs (auto-generated)
graphify-out/

# Large data, outputs, and logs (not versioned)
data/
generated_data/
figures/
documents/
logs/
notebooks/*.html
notebooks/*_files/
_archive/

# Figure images written next to configs/scratchpads — regenerate, don't version
analysis/**/*.png
analysis/**/*.pdf
Rplots.pdf

# Quarto/Rmd renders next to their source (analysis/11_manuscript_numbers.qmd)
analysis/*.html

# Synthetic world (analysis/bash/tools/run_synthetic_pipeline.sh): the sandbox and
# the configs its deploy generates (regenerated by every run)
synthetic_world/
analysis/configs/synth_run1_*/
analysis/configs/sim_synth_run1_*/
analysis/configs/forecast_country_by_group_synth_run1/
analysis/configs/hindcast_by_group_synth_run1/
analysis/configs/event_attribution_synth_run1/
analysis/configs/*_synth_run1.yml
analysis/configs/season_ends_*_synth_run1.csv

# environment files
.env

# Deploy-generated configs (analysis/utils/deploy_prod_run.R --stage gen_*):
# fit batches, simulator templates, forecast / hindcast / event configs and
# manifests. Only the hand-written configs are versioned (configs/README.md).
analysis/configs/*/
!analysis/configs/deploy/
!analysis/configs/results/
!analysis/configs/sim_templates/
!analysis/configs/pop_extract/
analysis/configs/*_horizons_*.yml
analysis/configs/forecast_attribution_*.yml
analysis/configs/season_ends_*.csv
analysis/11_manuscript_numbers.html
analysis/11_manuscript_numbers_files/

# Your cluster profile (copy of analysis/bash/cluster.profile.example)
analysis/bash/cluster.profile
